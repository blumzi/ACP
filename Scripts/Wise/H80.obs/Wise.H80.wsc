<?xml version="1.0" ?>
<package>
	<comment>
    <![CDATA[
    'tabs=4
    -----------------------------------------------------------------------------------------

    Script:         Wise.H80.wsc
    Author:         Arie Blumenzweig <theblumz@gmail.com>
    Version:        1.0
    Requires:       Windows Script 5.6 or later (installed by ACP setup)

    Description:    This script provides support for the H80 additional polarized qhy550p camera
                    
    Environment:    This is a Windows Script Component. 
                    
    Edit History:
        27-Dec-2025   Initial Edit
    -----------------------------------------------------------------------------------------
    ]]>
	</comment>
    <component>
        <?component error="true" debug="true" ?>
        <registration progid="Wise.H80"
                      classid="{F1A8C7D3-6B4E-4D0A-9C7B-2C6E5D12A9F4}"
                      description="H80 support for the qhy550p camera"
                      remotable="no"
                      version="1.0">
        </registration>
        <public>
            <method name="TargetEnd">
                <parameter name="Plan" />
                <parameter name="Target" />
                <parameter name="NextTarget" />
            </method>
            <method name="ImageComplete">
                <parameter name="ImageFile" />
            </method>
        </public>
        <object id="FSO" progid="Scripting.FileSystemObject" events="false" reference="false" />

        <script language="JScript">
                    <![CDATA[

                                                                                                                                                                                                                                                                                                                                                    var wise_util = new ActiveXObject("Wise.Util");
                var acp_util = new ActiveXObject("ACP.Util");
                var focuser = new ActiveXObject("FocusMax.FocusControl");
                var qhy550p = new ActiveXObject("Wise.H80.QHY550P");
                var flipmirror = new ActiveXObject("Wise.H80.FlipMirror");
                var label = wise_util.mklabel("H80");

                var default_exposure_seconds = 300; // seconds
                var default_focuser_offset = 240; // steps
                var default_gain = 85; // QHY550P gain (0-100)
                var default_offset = 10; // QHY550P offset (0-100)

                var latest_imgFile = null;

            function ImageComplete(imgFile) {
                wise_util.info("H80.ImageComplete: '" + imgFile + "'");
                latest_imgFile = imgFile;
            }

                // Public entry: TargetEnd(Plan, Target, NextTarget)
            function TargetEnd(pl, tgt, nexttgt) {


                    var obs = wise_util.observatory
                    if (obs != "h80") {
                        wise_util.warning("This observatory is '" + obs + "', not 'h80', skipping.");
                        return;
                    }

                    wise_util.info("H80.TargetEnd called for target '" + tgt.Name + "'");

                    // Start from defaults, then layer on configuration: legacy tag-based
                    // config is applied first, then a [ polar ... ] string spec found in
                    // any target field overrides whichever keys it specifies.
                    var polar_params = default_polar_parameters();

                    // Legacy tag-based config.
                    try {
                        for (var tag in tgt.Tags) {
                            if (tag == "polar") {
                                if (parseBool(tgt.Tags[tag])) polar_params.do_polar = true;
                            } else if (tag == "polar-focus-offset") {
                                polar_params.focus_offset = parse_int_param(tgt.Tags[tag], polar_params.focus_offset, tag);
                            } else if (tag == "polar-exposure") {
                                polar_params.exposure = parse_int_param(tgt.Tags[tag], polar_params.exposure, tag);
                            } else if (tag == "polar-gain") {
                                polar_params.gain = parse_int_param(tgt.Tags[tag], polar_params.gain, tag);
                            } else if (tag == "polar-offset") {
                                polar_params.offset = parse_int_param(tgt.Tags[tag], polar_params.offset, tag);
                            } else if (tag == "polar-number-of-exposures") {
                                polar_params.number_of_exposures = parse_int_param(tgt.Tags[tag], polar_params.number_of_exposures, tag);
                            }
                        }
                    } catch (e) {
                        wise_util.info("no readable tags: " + e.description);
                    }

                    // The "[ polar ... ]" spec lives in the Observation's Description field.
                    try {
                        var description = tgt.Description;
                        if (description != null && typeof description == "string") {
                            wise_util.info("target Description = [:" + description + ":]");
                            if (parse_polar_parameters(description, polar_params))
                                wise_util.info("polar parameters taken from Description");
                        }
                    } catch (e) {
                        wise_util.info("could not read target Description: " + e.description);
                    }

                    try {

                        if (!polar_params.do_polar) {
                            wise_util.info("skipping polar camera");
                            return;
                        }

                        wise_util.info("polar: focus-offset=" + polar_params.focus_offset +
                                       ", exposure=" + polar_params.exposure +
                                       ", number-of-exposures=" + polar_params.number_of_exposures +
                                       ", gain=" + polar_params.gain +
                                       ", offset=" + polar_params.offset +
                                       ", dark=" + polar_params.dark +
                                       ", bias=" + polar_params.bias);

                        var saved_focus_position = focuser.Position;

                        move_focuser(saved_focus_position + polar_params.focus_offset);
                        move_flipmirror("polar");
                        qhy550p.Take_Exposures(
                            polar_params.exposure,
                            latest_imgFile,
                            polar_params.gain,
                            polar_params.offset,
                            polar_params.number_of_exposures,
                            polar_params.dark,
                            polar_params.bias
                        );
                        move_focuser(saved_focus_position);
                        move_flipmirror("main");

                        wise_util.info("TargetEnd completed successfully.");

                    } catch (e) {
                        wise_util.error("Exception: " + e.description);
                    }

                    latest_imgFile = null; // reset for next time
                }

                function move_flipmirror(camera) {
                    var start = getTimer();
                    var timeout = 120; // seconds
                    var label = "FlipMiror: ";

                    if (flipmirror.CurrentCamera() == camera)
                        return;

                    flipmirror.SelectCamera(camera);
                    while (flipmirror.CurrentCamera() != camera && (getTimer() - start) < timeout) {
                        acp_util.WaitForMilliseconds(1000);
                    }
                    if (flipmirror.CurrentCamera() != camera) {
                        throw new Error(label + "timeout");
                    }
                    wise_util.info(label + "at '" + camera + "' camera");
                }

                function move_focuser(new_position) {
                    var timeout = 120; // seconds
                    var start = getTimer();
                    var label = "Focuser: ";

                    wise_util.info(label + focuser.Position + " -> " + new_position);

                    focuser.Move(new_position);
                    while (focuser.IsBusy && (getTimer() - start) < timeout) {
                        acp_util.WaitForMilliseconds(500);
                    }
                    if (focuser.IsBusy) {
                        throw new Error(label + "timeout");
                    }
                    wise_util.info(label + "at " + focuser.Position);
                }

                function getTimer() {
                    return new Date().getTime() / 1000;
                }

                // Default polar parameters; callers layer tag-based and/or string-spec
                // configuration on top of these.
                function default_polar_parameters() {
                    return {
                        do_polar: false,
                        focus_offset: default_focuser_offset,
                        exposure: default_exposure_seconds,
                        number_of_exposures: 1,
                        gain: default_gain,
                        offset: default_offset,
                        dark: false,
                        bias: false
                    };
                }

                // Parse a polar spec of the form:
                //   [ polar focus-offset=N exposure=N.N number-of-exposures=N gain=N offset=N dark bias ]
                // The spec may be embedded in surrounding free text (e.g. an Observation
                // Description like "Target GRAL 1651 [ polar ... ]"); the first [ ... ] block
                // is extracted. The 'polar' marker and keys are case-insensitive. The
                // focus-offset key also accepts the aliases 'focuser-offset'. Every key=value is optional; only the keys actually present
                // are written into `params`, so this can be layered over existing (e.g.
                // tag-based) config. Returns true if `value` carried a polar spec, false
                // otherwise (leaving `params` untouched).
                function parse_polar_parameters(value, params) {
                    if (typeof value != "string")
                        return false;

                    // Extract the first [ ... ] block from anywhere within the text.
                    var open = value.indexOf("[");
                    var close = value.lastIndexOf("]");
                    if (open < 0 || close < 0 || close <= open)
                        return false;

                    var inner = str_trim(value.substring(open + 1, close));
                    var tokens = inner.split(/\s+/);

                    var found_polar = false;
                    var updates = {}; // only the keys explicitly present in the spec

                    for (var i = 0; i < tokens.length; i++) {
                        var token = tokens[i];
                        if (token == "")
                            continue;

                        var eq = token.indexOf("=");
                        var key = (eq < 0) ? token : token.substring(0, eq);
                        var val = (eq < 0) ? null : token.substring(eq + 1);
                        key = str_trim(key).toLowerCase(); // case-insensitive

                        if (key == "polar") {
                            found_polar = true;
                        } else if (key == "focus-offset" || key == "focuser-offset") {
                            updates.focus_offset = parse_int_param(val, params.focus_offset, key);
                        } else if (key == "exposure") {
                            updates.exposure = parse_float_param(val, params.exposure, key);
                        } else if (key == "number-of-exposures") {
                            updates.number_of_exposures = parse_int_param(val, params.number_of_exposures, key);
                        } else if (key == "gain") {
                            updates.gain = parse_int_param(val, params.gain, key);
                        } else if (key == "offset") {
                            updates.offset = parse_int_param(val, params.offset, key);
                        } else if (key == "dark") {
                            updates.dark = (val == null) ? true : parseBool(val);
                        } else if (key == "bias") {
                            updates.bias = (val == null) ? true : parseBool(val);
                        } else {
                            wise_util.warning("parse_polar_parameters: ignoring unknown token '" + token + "'");
                        }
                    }

                    // Only treat this as a polar spec if the 'polar' marker was present.
                    if (!found_polar)
                        return false;

                    // A dark frame must match the light's exposure time, so 'exposure=' is
                    // mandatory whenever 'dark' is requested. (Bias frames are zero-length,
                    // so they don't require it.)
                    if (updates.dark && typeof updates.exposure == "undefined") {
                        wise_util.warning("polar: 'dark' requires 'exposure=' to be specified; ignoring 'dark'.");
                        updates.dark = false;
                    }

                    params.do_polar = true;
                    for (var k in updates)
                        params[k] = updates[k];

                    return true;
                }

                // parseInt with a fallback; warns and returns `fallback` on a bad value.
                function parse_int_param(val, fallback, key) {
                    var n = parseInt(val, 10);
                    if (isNaN(n)) {
                        wise_util.warning("invalid integer for '" + key + "': '" + val + "', using default " + fallback);
                        return fallback;
                    }
                    return n;
                }

                // parseFloat with a fallback; warns and returns `fallback` on a bad value.
                function parse_float_param(val, fallback, key) {
                    var n = parseFloat(val);
                    if (isNaN(n)) {
                        wise_util.warning("invalid number for '" + key + "': '" + val + "', using default " + fallback);
                        return fallback;
                    }
                    return n;
                }

                function parseBool(value) {
                    if (typeof value === "boolean") return value;
                    if (typeof value === "string") {
                        var lower = str_trim(value.toLowerCase());
                        if (lower === "true" || lower === "1" || lower === "yes" || lower === "on")
                            return true;
                        else if (lower === "false" || lower === "0" || lower === "no" || lower === "off")
                            return false;
                        else
                            throw new Error("Cannot parse boolean value: '" + value + "'");
                    }
                }

                function str_trim(str) {
                    return str.replace(/^\s+|\s+$/g, "");
                }

                    ]]>
        </script>
    </component>
</package>
